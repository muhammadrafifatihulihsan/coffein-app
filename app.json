{
	"expo": {
		"name": "coffein",
		"slug": "coffein",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/coffein-icon.jpeg",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"splash": {
			"image": "./assets/coffein-icon.jpeg",
			"resizeMode": "contain",
			"backgroundColor": "#f9f0e7"
		},
		"ios": {
			"supportsTablet": true
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/coffein-icon.jpeg",
				"backgroundColor": "#ffffff"
			},
			"edgeToEdgeEnabled": false,
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"favicon": "./assets/favicon.png"
		},
		"plugins": ["expo-router"],
		"scheme": "coffein"
	}
}
